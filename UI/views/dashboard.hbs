<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .metric-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .metric-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .pulse {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }

            100% {
                opacity: 1;
            }
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <i class="fas fa-chart-bar text-purple-600 text-2xl mr-3"></i>
                    <span class="text-xl font-bold text-gray-900">Performance Dashboard</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/dashboard" class="text-gray-700 hover:text-purple-600 transition-colors">
                        <i class="fas fa-home mr-1"></i> Main Dashboard
                    </a>
                    <a href="/list" class="text-gray-700 hover:text-purple-600 transition-colors">
                        <i class="fas fa-list mr-1"></i> Evidence List
                    </a>
                    <span class="text-gray-500">|</span>
                    <span class="text-sm text-gray-600">
                        <i class="fas fa-user mr-1"></i> {{user.name}}
                    </span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">System Performance Dashboard</h1>
            <p class="text-lg text-gray-600">Real-time monitoring of Evidence Management System performance and cryptographic operations</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Total Transactions -->
            <div class="metric-card bg-white p-6 rounded-xl shadow-lg border-l-4 border-blue-500">
                <div class="flex items-center">
                    <div class="p-3 bg-blue-100 rounded-lg">
                        <i class="fas fa-exchange-alt text-blue-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">Total Transactions</p>
                        <h3 class="text-2xl font-bold text-gray-900" id="totalTransactions">0</h3>
                    </div>
                </div>
            </div>
            
            <!-- Evidence Uploads -->
            <div class="metric-card bg-white p-6 rounded-xl shadow-lg border-l-4 border-green-500">
                <div class="flex items-center">
                    <div class="p-3 bg-green-100 rounded-lg">
                        <i class="fas fa-upload text-green-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">Evidence Uploads</p>
                        <h3 class="text-2xl font-bold text-gray-900" id="evidenceUploads">0</h3>
                    </div>
                </div>
            </div>
            
            <!-- Signature Verifications -->
            <div class="metric-card bg-white p-6 rounded-xl shadow-lg border-l-4 border-purple-500">
                <div class="flex items-center">
                    <div class="p-3 bg-purple-100 rounded-lg">
                        <i class="fas fa-signature text-purple-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">Signature Verifications</p>
                        <h3 class="text-2xl font-bold text-gray-900" id="signatureVerifications">0</h3>
                    </div>
                </div>
            </div>
            
            <!-- Average Latency -->
            <div class="metric-card bg-white p-6 rounded-xl shadow-lg border-l-4 border-yellow-500">
                <div class="flex items-center">
                    <div class="p-3 bg-yellow-100 rounded-lg">
                        <i class="fas fa-clock text-yellow-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm text-gray-500">Avg Latency</p>
                        <h3 class="text-2xl font-bold text-gray-900" id="averageLatency">0.00s</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Crypto Performance Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Crypto Operations Chart -->
            <div class="bg-white p-6 rounded-xl shadow-lg">
                <h3 class="text-lg font-semibold mb-4 text-gray-900">Cryptographic Performance</h3>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div class="text-center p-4 bg-blue-50 rounded-lg">
                        <p class="text-sm text-blue-600 font-medium">Signature Creation</p>
                        <p class="text-xl font-bold text-blue-800" id="signatureCreationTime">0ms</p>
                    </div>
                    <div class="text-center p-4 bg-green-50 rounded-lg">
                        <p class="text-sm text-green-600 font-medium">Signature Verification</p>
                        <p class="text-xl font-bold text-green-800" id="signatureVerificationTime">0ms</p>
                    </div>
                </div>
                <canvas id="cryptoChart" width="400" height="200"></canvas>
            </div>

            <!-- Transaction Distribution -->
            <div class="bg-white p-6 rounded-xl shadow-lg">
                <h3 class="text-lg font-semibold mb-4 text-gray-900">Transaction Distribution</h3>
                <canvas id="transactionChart" width="400" height="200"></canvas>
            </div>
        </div>

        <!-- Latency Trends -->
        <div class="bg-white p-6 rounded-xl shadow-lg mb-8">
            <h3 class="text-lg font-semibold mb-4 text-gray-900">Response Time Trends</h3>
            <canvas id="latencyChart" width="400" height="250"></canvas>
        </div>

        <!-- System Status -->
        <div class="bg-white p-6 rounded-xl shadow-lg">
            <h3 class="text-lg font-semibold mb-4 text-gray-900">System Status</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="text-center p-4 bg-green-50 rounded-lg">
                    <i class="fas fa-server text-green-500 text-2xl mb-2"></i>
                    <p class="font-medium text-green-800">Application</p>
                    <p class="text-sm text-green-600">Running</p>
                </div>
                <div class="text-center p-4 bg-blue-50 rounded-lg">
                    <i class="fas fa-users text-blue-500 text-2xl mb-2"></i>
                    <p class="font-medium text-blue-800">Active Sessions</p>
                    <p class="text-2xl font-bold text-blue-600" id="activeSessions">0</p>
                </div>
                <div class="text-center p-4 bg-purple-50 rounded-lg">
                    <i class="fas fa-database text-purple-500 text-2xl mb-2"></i>
                    <p class="font-medium text-purple-800">Metrics Collected</p>
                    <p class="text-sm text-purple-600" id="metricsCollected">0</p>
                </div>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Initialize Socket.io
        const socket = io();
        let metricsHistory = [];
        const maxHistoryLength = 20;

        // Initialize Charts
        const cryptoCtx = document.getElementById('cryptoChart').getContext('2d');
        const transactionCtx = document.getElementById('transactionChart').getContext('2d');
        const latencyCtx = document.getElementById('latencyChart').getContext('2d');

        const cryptoChart = new Chart(cryptoCtx, {
            type: 'bar',
            data: {
                labels: ['Signature Creation', 'Signature Verification'],
                datasets: [{
                    label: 'Time (ms)',
                    data: [0, 0],
                    backgroundColor: ['#3B82F6', '#10B981'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    },
                    title: {
                        display: true,
                        text: 'Crypto Operation Performance'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Milliseconds'
                        }
                    }
                }
            }
        });

        const transactionChart = new Chart(transactionCtx, {
            type: 'doughnut',
            data: {
                labels: ['Evidence Uploads', 'Signature Verifications', 'Other Transactions'],
                datasets: [{
                    data: [0, 0, 0],
                    backgroundColor: ['#10B981', '#8B5CF6', '#F59E0B'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        const latencyChart = new Chart(latencyCtx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Average Latency (seconds)',
                    data: [],
                    borderColor: '#EF4444',
                    backgroundColor: 'rgba(239, 68, 68, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Seconds'
                        }
                    }
                }
            }
        });

        // Add this function to update crypto performance in real-time
        function updateCryptoPerformanceFromMetrics(metrics) {
            // Check if we have recent crypto operations data
            if (metrics.recentCryptoOps) {
                const creationTime = metrics.recentCryptoOps.signatureCreation || 0;
                const verificationTime = metrics.recentCryptoOps.signatureVerification || 0;
                
                document.getElementById('signatureCreationTime').textContent = creationTime + 'ms';
                document.getElementById('signatureVerificationTime').textContent = verificationTime + 'ms';
                
                cryptoChart.data.datasets[0].data = [creationTime, verificationTime];
                cryptoChart.update();
            }
        }

        // Update the socket listener to include crypto metrics
        socket.on('metrics-update', (metrics) => {
            document.getElementById('totalTransactions').textContent = metrics.totalTransactions;
            document.getElementById('evidenceUploads').textContent = metrics.evidenceUploads;
            document.getElementById('signatureVerifications').textContent = metrics.signatureVerifications;
            document.getElementById('averageLatency').textContent = (metrics.averageLatency * 1000).toFixed(2) + 'ms'; // Convert to ms
            
            // Update crypto performance
            updateCryptoPerformanceFromMetrics(metrics);
            
            // Update transaction chart
            transactionChart.data.datasets[0].data = [
                metrics.evidenceUploads,
                metrics.signatureVerifications,
                Math.max(0, metrics.totalTransactions - metrics.evidenceUploads - metrics.signatureVerifications)
            ];
            transactionChart.update();

            // Update latency chart
            const now = new Date().toLocaleTimeString();
            latencyChart.data.labels.push(now);
            latencyChart.data.datasets[0].data.push(metrics.averageLatency);
            
            if (latencyChart.data.labels.length > maxHistoryLength) {
                latencyChart.data.labels.shift();
                latencyChart.data.datasets[0].data.shift();
            }
            latencyChart.update();
        });
    </script>
</body>

</html>
