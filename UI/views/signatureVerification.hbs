<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-lg p-8">
            <div class="text-center mb-8">
                <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full {{#if isValid}}bg-green-100{{else}}bg-red-100{{/if}} mb-4">
                    <i class="fas {{#if isValid}}fa-check-circle text-green-600{{else}}fa-times-circle text-red-600{{/if}} text-2xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-900">Digital Signature Verification</h1>
                <p class="mt-2 text-gray-600">Verify the authenticity of evidence</p>
            </div>

            <!-- Evidence Details -->
            <div class="bg-gray-50 rounded-lg p-6 mb-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Evidence Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Evidence ID</label>
                        <p class="mt-1 text-sm text-gray-900 font-mono">{{evidence.evidenceId}}</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Title</label>
                        <p class="mt-1 text-sm text-gray-900">{{evidence.title}}</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Uploader</label>
                        <p class="mt-1 text-sm text-gray-900 font-mono">{{evidence.uploaderAddress}}</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Status</label>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            {{evidence.status}}
                        </span>
                    </div>
                </div>
            </div>

            <!-- Signature Verification Result -->
            <div class="bg-{{#if isValid}}green{{else}}red{{/if}}-50 border border-{{#if isValid}}green{{else}}red{{/if}}-200 rounded-lg p-6 mb-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <i class="fas {{#if isValid}}fa-check-circle text-green-400{{else}}fa-times-circle text-red-400{{/if}} text-2xl"></i>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-{{#if isValid}}green{{else}}red{{/if}}-800">
                            {{#if isValid}}✅ Signature Valid{{else}}❌ Signature Invalid{{/if}}
                        </h3>
                        <p class="mt-1 text-{{#if isValid}}green{{else}}red{{/if}}-700">
                            {{#if isValid}}
                            This evidence has been digitally signed and verified. The data integrity is confirmed.
                            {{else}}
                            This evidence signature could not be verified. The data may have been tampered with.
                            {{/if}}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Signature Details -->
            <div class="bg-blue-50 rounded-lg p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Digital Signature Details</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Signature</label>
                        <div class="mt-1 p-3 bg-white border border-gray-300 rounded-md text-sm font-mono break-all">
                            {{evidence.signature}}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Data Hash</label>
                        <div class="mt-1 p-3 bg-white border border-gray-300 rounded-md text-sm font-mono break-all">
                            {{evidence.signedDataHash}}
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex justify-end space-x-4">
                <a href="/list" class="px-6 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition duration-150">
                    Back to List
                </a>
                <a href="/evidence/{{evidence.evidenceId}}" class="px-6 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition duration-150">
                    View Evidence Details
                </a>
            </div>
        </div>
    </div>
</div>
{{! Add this to your existing signatureVerification.hbs }}

<!-- Debug Information (Visible with Ctrl+D) -->
<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 hidden debug-info mt-4">
    <h4 class="text-sm font-medium text-yellow-800 mb-2">Debug Information</h4>
    <div class="space-y-2">
        <div>
            <label class="text-sm font-medium text-yellow-700">Raw Verification Result:</label>
            <pre class="text-xs text-yellow-700 whitespace-pre-wrap">{{{json verificationResult}}}</pre>
        </div>
        <div>
            <label class="text-sm font-medium text-yellow-700">Evidence Data:</label>
            <pre class="text-xs text-yellow-700 whitespace-pre-wrap">{{{json evidence}}}</pre>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Show debug info on Ctrl+D press
    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.key === 'd') {
            e.preventDefault();
            const debugInfo = document.querySelector('.debug-info');
            if (debugInfo) {
                debugInfo.classList.toggle('hidden');
                console.log('Debug info toggled');
            }
        }
    });
});
</script>