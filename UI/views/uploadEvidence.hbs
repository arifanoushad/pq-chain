<script>
document.querySelector('form').addEventListener('submit', function(e) {
    console.log('🔍 Form submitted with algorithm:', document.querySelector('input[name="algorithm"]:checked')?.value);
    console.log('🔍 File selected:', document.getElementById('file').files[0]?.name);
});
</script>
<style>
.algorithm-card:hover {
    border-color: #3b82f6;
    background-color: #f8fafc;
}

.card-hover {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.card-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.border-dashed:hover {
    border-color: #a78bfa;
}
</style>