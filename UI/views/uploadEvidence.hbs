<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-lg p-8 card-hover">
            <div class="text-center mb-8">
                <i class="fas fa-cloud-upload-alt text-purple-600 text-4xl mb-4"></i>
                <h1 class="text-3xl font-bold text-gray-900">Upload Evidence</h1>
                <p class="mt-2 text-gray-600">Securely store evidence on IPFS and blockchain with quantum-resistant cryptography</p>
            </div>

            {{#if message}}
            <div class="mb-6 p-4 rounded-lg bg-yellow-100 text-yellow-700">
                {{message}}
            </div>
            {{/if}}

            <form action="/upload" method="POST" enctype="multipart/form-data" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="evidenceID" class="block text-sm font-medium text-gray-700">Evidence ID *</label>
                        <input type="text" name="evidenceID" id="evidenceID" required 
                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"
                               placeholder="Enter unique evidence ID">
                    </div>

                    <div>
                        <label for="title" class="block text-sm font-medium text-gray-700">Evidence Title *</label>
                        <input type="text" name="title" id="title" required 
                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"
                               placeholder="Enter evidence title">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Select File *</label>
                    <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg hover:border-purple-400 transition duration-150">
                        <div class="space-y-1 text-center">
                            <i class="fas fa-file-upload text-gray-400 text-3xl mx-auto"></i>
                            <div class="flex text-sm text-gray-600">
                                <label for="file" class="relative cursor-pointer bg-white rounded-md font-medium text-purple-600 hover:text-purple-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-purple-500">
                                    <span>Upload a file</span>
                                    <input id="file" name="file" type="file" class="sr-only" accept=".pdf,.jpg,.jpeg,.png,.docx" required>
                                </label>
                                <p class="pl-1">or drag and drop</p>
                            </div>
                            <p class="text-xs text-gray-500">PDF, JPG, PNG, DOCX up to 10MB</p>
                        </div>
                    </div>
                </div>

                <!-- 🔽 ADDED: Algorithm Selection Section 🔽 -->
                <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
                    <label class="block text-sm font-medium text-blue-900 mb-3">
                        <i class="fas fa-lock mr-2"></i>Select Cryptographic Algorithm
                    </label>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {{#each supportedAlgorithms}}
                        <div class="algorithm-card border rounded-lg p-3 cursor-pointer transition-all duration-200 
                                    {{#if (eq @key ../defaultAlgorithm)}}border-blue-500 bg-blue-50{{else}}border-gray-300{{/if}}"
                             onclick="selectAlgorithm('{{@key}}')">
                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="font-medium text-gray-900">{{this.name}}</div>
                                    <div class="text-xs text-gray-600 mt-1">
                                        {{#if (eq this.type 'pqc')}}
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <i class="fas fa-shield-alt mr-1"></i>PQC
                                        </span>
                                        {{else}}
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            <i class="fas fa-lock mr-1"></i>Classical
                                        </span>
                                        {{/if}}
                                        • {{this.security}}-bit security
                                    </div>
                                </div>
                                <input type="radio" name="algorithm" value="{{@key}}" 
                                       {{#if (eq @key ../defaultAlgorithm)}}checked{{/if}}
                                       class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300">
                            </div>
                            {{#if this.recommended}}
                            <div class="mt-2 text-xs text-blue-600 font-medium">
                                <i class="fas fa-star mr-1"></i>Recommended
                            </div>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                    
                    <div class="mt-3 text-xs text-blue-600">
                        <i class="fas fa-info-circle mr-1"></i>
                        Default: {{defaultAlgorithm}} • Your preferred algorithm from registration
                    </div>
                </div>
                <!-- 🔼 END: Algorithm Selection Section 🔼 -->

                <div class="bg-purple-50 rounded-lg p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-info-circle text-purple-400"></i>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-purple-800">Security Notice</h3>
                            <div class="mt-2 text-sm text-purple-700">
                                <p>Your file will be encrypted and stored on IPFS. The hash will be permanently recorded on the blockchain for immutability and transparency.</p>
                                <p class="mt-1"><strong>PQC Algorithms:</strong> Provide quantum-resistant security for long-term evidence preservation.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-4">
                    <a href="/dashboard" class="px-6 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition duration-150">
                        Cancel
                    </a>
                    <button type="submit" class="inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition duration-150">
                        <i class="fas fa-upload mr-2"></i>
                        Upload & Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

