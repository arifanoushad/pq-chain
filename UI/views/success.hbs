<div class="min-h-screen bg-gradient-to-br from-green-50 to-blue-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
            <!-- Success Icon -->
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-6">
                <i class="fas fa-check-circle text-green-600 text-2xl"></i>
            </div>

            <!-- Success Message -->
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Success! 🎉</h2>
            <p class="text-gray-600 mb-6">{{message}}</p>

            <!-- Evidence ID (if available) -->
            {{#if evidenceId}}
            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <p class="text-sm font-medium text-gray-700 mb-1">Evidence ID</p>
                <p class="text-sm font-mono text-gray-900 break-all">{{evidenceId}}</p>
            </div>
            {{/if}}

            <!-- Blockchain Result -->
            {{#if result}}
            <div class="bg-blue-50 rounded-lg p-4 mb-6 text-left">
                <p class="text-sm font-medium text-blue-700 mb-2 flex items-center">
                    <i class="fas fa-link mr-2"></i>
                    Blockchain Transaction
                </p>
                <div class="text-xs font-mono text-blue-600 break-all bg-blue-100 p-2 rounded">
                    {{result}}
                </div>
            </div>
            {{/if}}

            <!-- Action Buttons -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <a href="/upload" 
                   class="inline-flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition duration-150 shadow-sm">
                    <i class="fas fa-upload mr-2"></i>
                    Upload Another
                </a>
                
                <a href="/list" 
                   class="inline-flex items-center justify-center px-4 py-3 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition duration-150 shadow-sm">
                    <i class="fas fa-list mr-2"></i>
                    View All Evidence
                </a>
            </div>

            <!-- Additional Navigation -->
            <div class="mt-6 pt-6 border-t border-gray-200">
                <div class="flex justify-center space-x-6">
                    <a href="/dashboard" class="text-sm text-gray-500 hover:text-gray-700 transition duration-150 flex items-center">
                        <i class="fas fa-tachometer-alt mr-1"></i>
                        Dashboard
                    </a>
                    <a href="/" class="text-sm text-gray-500 hover:text-gray-700 transition duration-150 flex items-center">
                        <i class="fas fa-home mr-1"></i>
                        Home
                    </a>
                </div>
            </div>

            <!-- Quick Stats (Optional) -->
            <div class="mt-6 bg-green-50 rounded-lg p-4">
                <div class="flex items-center justify-center text-sm text-green-700">
                    <i class="fas fa-shield-alt mr-2"></i>
                    <span>Evidence securely stored on blockchain</span>
                </div>
            </div>
        </div>

        <!-- Progress Steps (Visual) -->
        <div class="bg-white rounded-2xl shadow-xl p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4 text-center">Process Completed</h3>
            <div class="flex items-center justify-between">
                <div class="flex flex-col items-center">
                    <div class="h-8 w-8 rounded-full bg-green-500 flex items-center justify-center">
                        <i class="fas fa-check text-white text-xs"></i>
                    </div>
                    <span class="text-xs mt-2 text-gray-600">Uploaded</span>
                </div>
                <div class="flex-1 h-1 bg-green-500 mx-2"></div>
                <div class="flex flex-col items-center">
                    <div class="h-8 w-8 rounded-full bg-green-500 flex items-center justify-center">
                        <i class="fas fa-check text-white text-xs"></i>
                    </div>
                    <span class="text-xs mt-2 text-gray-600">IPFS Stored</span>
                </div>
                <div class="flex-1 h-1 bg-green-500 mx-2"></div>
                <div class="flex flex-col items-center">
                    <div class="h-8 w-8 rounded-full bg-green-500 flex items-center justify-center">
                        <i class="fas fa-check text-white text-xs"></i>
                    </div>
                    <span class="text-xs mt-2 text-gray-600">Blockchain</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confetti Effect (Optional) -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Simple confetti effect
    setTimeout(() => {
        confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: 0.6 }
        });
    }, 500);

    // Add some interactive elements
    const successCard = document.querySelector('.bg-white');
    successCard.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-2px)';
        this.style.transition = 'transform 0.2s ease';
    });
    
    successCard.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
    });

    // Log success for analytics
    console.log('Success page loaded for:', '{{message}}');
});
</script>

<style>
.font-mono {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.bg-white {
    animation: fadeInUp 0.6s ease-out;
}

.hover\:bg-purple-700:hover {
    background-color: #7c3aed;
}

.hover\:bg-gray-50:hover {
    background-color: #f9fafb;
}
</style>