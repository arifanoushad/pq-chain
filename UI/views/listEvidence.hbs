<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-lg p-8">
            <div class="text-center mb-8">
                <i class="fas fa-list text-purple-600 text-4xl mb-4"></i>
                <h1 class="text-3xl font-bold text-gray-900">All Evidence Records</h1>
                <p class="mt-2 text-gray-600">Complete evidence repository</p>
            </div>

            {{#if success}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" id="successMessage">
                <div class="flex items-center">
                    <i class="fas fa-check-circle mr-2"></i>
                    <span>{{success}}</span>
                </div>
            </div>
            {{/if}}

            {{#if error}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" id="errorMessage">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    <span>{{error}}</span>
                </div>
            </div>
            {{/if}}

            {{#if evidenceList.length}}
            <div class="mb-4 flex justify-between items-center">
                <div class="text-sm text-gray-600">
                    Total: <span class="font-semibold">{{evidenceList.length}}</span> evidence records
                </div>
                <div class="text-sm text-gray-500">
                    <i class="fas fa-clock mr-1"></i>
                    {{currentTime}}
                </div>
            </div>

            <div class="overflow-x-auto border border-gray-200 rounded-lg">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Uploaded By</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">CID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {{#each evidenceList}}
                        <tr class="hover:bg-gray-50 transition duration-150">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-900">{{this.evidenceId}}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">{{this.title}}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium status-badge
                                    {{#if (eq this.status 'Submitted')}}bg-green-100 text-green-800
                                    {{else if (eq this.status 'Under Review')}}bg-yellow-100 text-yellow-800
                                    {{else if (eq this.status 'Approved')}}bg-blue-100 text-blue-800
                                    {{else if (eq this.status 'Rejected')}}bg-red-100 text-red-800
                                    {{else}}bg-gray-100 text-gray-800{{/if}}">
                                    <i class="fas 
                                        {{#if (eq this.status 'Submitted')}}fa-paper-plane
                                        {{else if (eq this.status 'Under Review')}}fa-search
                                        {{else if (eq this.status 'Approved')}}fa-check
                                        {{else if (eq this.status 'Rejected')}}fa-times
                                        {{else}}fa-question{{/if}} mr-1"></i>
                                    {{this.status}}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <span class="text-sm text-gray-900">{{this.ownerId}}</span>
                                    {{#if (or (eq this.ownerId "PoliceOrg") (eq this.ownerId "policeorg"))}}
                                    <span class="ml-2 px-2 py-1 text-xs bg-purple-100 text-purple-800 rounded-full border border-purple-200">
                                        <i class="fas fa-user-shield mr-1"></i>Current
                                    </span>
                                    {{/if}}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    {{#if this.uploaderAddress}}
                                    <div class="text-sm font-mono text-gray-600" title="{{this.uploaderAddress}}">
                                        {{substr this.uploaderAddress 0 8}}...
                                        <br>
                                        <span class="text-xs text-gray-400">(Uploader)</span>
                                    </div>
                                    {{else}}
                                    <span class="text-sm text-gray-400 italic">Unknown</span>
                                    {{/if}}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <div class="flex items-center">
                                    {{#if this.mimeType}}
                                        {{#if (eq (substr this.mimeType 0 5) 'image')}}
                                        <i class="fas fa-file-image text-blue-500 mr-2"></i>
                                        {{else if (eq this.mimeType 'application/pdf')}}
                                        <i class="fas fa-file-pdf text-red-500 mr-2"></i>
                                        {{else if (eq (substr this.mimeType 0 5) 'video')}}
                                        <i class="fas fa-file-video text-purple-500 mr-2"></i>
                                        {{else if (eq (substr this.mimeType 0 5) 'audio')}}
                                        <i class="fas fa-file-audio text-green-500 mr-2"></i>
                                        {{else}}
                                        <i class="fas fa-file text-gray-500 mr-2"></i>
                                        {{/if}}
                                    {{else}}
                                        <i class="fas fa-file text-gray-500 mr-2"></i>
                                    {{/if}}
                                    {{this.mimeType}}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-400" title="{{this.cid}}">
                                {{#if this.cid}}
                                {{substr this.cid 0 8}}...
                                {{else}}
                                <span class="text-red-400">No CID</span>
                                {{/if}}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex space-x-2">
                                    {{#if (or (eq this.ownerId "PoliceOrg") (eq this.ownerId "policeorg"))}}
                                    <a href="/evidence/{{this.evidenceId}}/transfer" 
                                       class="inline-flex items-center px-3 py-2 border border-transparent text-xs font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-150 shadow-sm"
                                       title="Transfer to another organization">
                                        <i class="fas fa-exchange-alt mr-1"></i>
                                        Transfer
                                    </a>
                                    {{else}}
                                    <span class="inline-flex items-center px-3 py-2 border border-gray-300 text-xs font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed"
                                          title="Only PoliceOrg can transfer evidence">
                                        <i class="fas fa-exchange-alt mr-1"></i>
                                        Transfer
                                    </span>
                                    {{/if}}
                                    
                                    {{#if this.cid}}
                                    <a href="/download/{{this.cid}}" 
                                       class="inline-flex items-center px-3 py-2 border border-transparent text-xs font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-150 shadow-sm"
                                       title="Download evidence file">
                                        <i class="fas fa-download mr-1"></i>
                                        Download
                                    </a>
                                    {{else}}
                                    <span class="inline-flex items-center px-3 py-2 border border-gray-300 text-xs font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed"
                                          title="No file available for download">
                                        <i class="fas fa-download mr-1"></i>
                                        Download
                                    </span>
                                    {{/if}}

                                    <!-- ✅ NEW: Digital Signature Verification Button -->
                                    {{#if this.signature}}
                                    <a href="/evidence/{{this.evidenceId}}/verify" 
                                       class="inline-flex items-center px-3 py-2 border border-green-300 text-xs font-medium rounded-md text-green-700 bg-green-50 hover:bg-green-100 transition duration-150 shadow-sm"
                                       title="Verify digital signature">
                                        <i class="fas fa-signature mr-1"></i>
                                        Verify Sig
                                    </a>
                                    {{/if}}
                                </div>
                                
                                <!-- Debug information (visible only during development) -->
                                <div class="mt-1 text-xs text-gray-400 hidden debug-info">
                                    Owner: "{{this.ownerId}}", Uploader: "{{this.uploaderAddress}}", CanTransfer: {{or (eq this.ownerId "PoliceOrg") (eq this.ownerId "policeorg")}}
                                    {{#if this.signature}}
                                    <br>Signature: {{substr this.signature 0 16}}...
                                    {{/if}}
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="fas fa-info-circle text-blue-400 mt-1"></i>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-blue-800">Information Panel</h3>
                        <div class="mt-2 text-sm text-blue-700">
                            <p class="flex items-center"><i class="fas fa-exchange-alt mr-2 text-red-500"></i> <strong>Transfer</strong> - Available for PoliceOrg owned evidence</p>
                            <p class="flex items-center mt-1"><i class="fas fa-download mr-2 text-blue-500"></i> <strong>Download</strong> - Download evidence files</p>
                            <p class="flex items-center mt-1"><i class="fas fa-user-circle mr-2 text-green-500"></i> <strong>Uploaded By</strong> - Shows who uploaded the evidence</p>
                            <p class="flex items-center mt-1"><i class="fas fa-signature mr-2 text-green-500"></i> <strong>Verify Signature</strong> - Verify digital signature authenticity</p>
                        </div>
                    </div>
                </div>
            </div>
            {{else}}
            <div class="text-center py-12">
                <i class="fas fa-inbox text-gray-400 text-4xl mb-4"></i>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No evidence records found</h3>
                <p class="text-gray-500 mb-6">Get started by uploading your first evidence file</p>
                <a href="/upload" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition duration-150">
                    <i class="fas fa-upload mr-2"></i>
                    Upload Evidence
                </a>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<!-- JavaScript for enhanced functionality -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Fix: Keep success/error messages visible (remove auto-hide)
    console.log('Page loaded - messages should remain visible');

    // Add confirmation for transfers
    const transferLinks = document.querySelectorAll('a[href*="/transfer"]');
    transferLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            if (!confirm('⚠️ Are you sure you want to transfer this evidence?\n\nThis action will:\n• Change ownership permanently\n• Be recorded on blockchain\n• Cannot be undone')) {
                e.preventDefault();
            }
        });
    });

    // Fix: Download button functionality
    const downloadButtons = document.querySelectorAll('a[href*="/download/"]');
    downloadButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            console.log('Download button clicked');
            
            // Add loading state
            const originalContent = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Preparing...';
            this.classList.add('cursor-not-allowed', 'opacity-75');
            
            // Reset after 10 seconds if download doesn't start (fallback)
            setTimeout(() => {
                if (this.innerHTML.includes('fa-spinner')) {
                    this.innerHTML = originalContent;
                    this.classList.remove('cursor-not-allowed', 'opacity-75');
                    console.log('Download timeout - reset button');
                }
            }, 10000);
        });
    });

    // Show debug info on Ctrl+D press (for development)
    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.key === 'd') {
            e.preventDefault();
            const debugInfos = document.querySelectorAll('.debug-info');
            debugInfos.forEach(debug => {
                debug.classList.toggle('hidden');
            });
            console.log('Debug info toggled');
        }
    });

    // Log current message state
    const successMessage = document.getElementById('successMessage');
    const errorMessage = document.getElementById('errorMessage');
    
    if (successMessage) {
        console.log('Success message found, will remain visible');
    }
    if (errorMessage) {
        console.log('Error message found, will remain visible');
    }
});

// Utility function to check if element is in viewport
function isInViewport(element) {
    const rect = element.getBoundingClientRect();
    return (
        rect.top >= 0 &&
        rect.left >= 0 &&
        rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
        rect.right <= (window.innerWidth || document.documentElement.clientWidth)
    );
}
</script>

<style>
/* Custom styles for better appearance */
.font-mono {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
}

.hover\:bg-gray-50:hover {
    background-color: #f9fafb;
}

.transition {
    transition-property: background-color, border-color, color, fill, stroke, opacity, box-shadow, transform;
    transition-duration: 150ms;
}

/* Ensure buttons have good contrast */
.bg-red-600 {
    background-color: #dc2626;
}

.bg-red-600:hover {
    background-color: #b91c1c;
}

.bg-blue-600 {
    background-color: #2563eb;
}

.bg-blue-600:hover {
    background-color: #1d4ed8;
}

/* Fix: Keep status badges always visible */
.status-badge {
    opacity: 1 !important;
    visibility: visible !important;
}

/* Focus styles for accessibility */
.focus\:ring-2:focus {
    --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);
    --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);
    box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);
}

/* Loading animation */
.fa-spin {
    animation: fa-spin 1s infinite linear;
}

@keyframes fa-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Ensure messages stay visible */
#successMessage,
#errorMessage {
    opacity: 1 !important;
    display: block !important;
}

/* ✅ NEW: Styles for signature verification button */
.bg-green-50 {
    background-color: #f0fdf4;
}

.border-green-300 {
    border-color: #86efac;
}

.text-green-700 {
    color: #15803d;
}

.bg-green-50:hover {
    background-color: #dcfce7;
}
</style>