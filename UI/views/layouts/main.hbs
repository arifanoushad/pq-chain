<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - EvidenceSecure</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/stylesheets/style.css" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-blue-50 to-cyan-50 min-h-screen">
    {{#if user}}
    <!-- Navigation Bar -->
    <nav class="bg-white/95 backdrop-blur-lg fixed w-full top-0 z-50 shadow-lg border-b border-blue-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg flex items-center justify-center shadow-lg">
                        <i class="fas fa-shield-alt text-white text-lg"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold text-blue-600">EvidenceSecure</span>
                        <p class="text-xs text-gray-500 -mt-1">Blockchain Powered</p>
                    </div>
                </div>

                <!-- Navigation Links -->
                <div class="hidden md:flex items-center space-x-8">
                    <a href="/dashboard" class="text-gray-700 hover:text-blue-600 font-medium transition-all duration-300 flex items-center">
                        <i class="fas fa-tachometer-alt mr-2"></i>
                        Dashboard
                    </a>
                    <a href="/upload" class="text-gray-700 hover:text-blue-600 font-medium transition-all duration-300 flex items-center">
                        <i class="fas fa-cloud-upload-alt mr-2"></i>
                        Upload Evidence
                    </a>
                    <a href="/list" class="text-gray-700 hover:text-blue-600 font-medium transition-all duration-300 flex items-center">
                        <i class="fas fa-list mr-2"></i>
                        All Evidence
                    </a>
                </div>

                <!-- User Menu -->
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-3 bg-blue-50 rounded-full px-4 py-2 border border-blue-100">
                        <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center shadow-sm">
                            <span class="text-white text-sm font-semibold">{{user.name.[0]}}</span>
                        </div>
                        <span class="text-sm font-medium text-gray-700">{{user.name}}</span>
                    </div>
                    <a href="/logout" class="btn-primary text-sm">
                        <i class="fas fa-sign-out-alt mr-2"></i>
                        Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Add space for fixed nav -->
    <div class="h-16"></div>
    {{/if}}

    <!-- Main Content -->
    <main class="{{#unless user}}min-h-screen{{/unless}}">
        {{{body}}}
    </main>

    <!-- Footer -->
    {{#if user}}
    <footer class="bg-gray-900 text-white py-8 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p>&copy; 2024 EvidenceSecure. All rights reserved.</p>
        </div>
    </footer>
    {{/if}}
</body>
</html>